# HTTP server
PORT=8787

# --- LLM: these only PREFILL the setup form at /setup (no auto-connect) ---
# The actual provider/model is chosen in the UI and saved to data/llm-config.json.
# Default provider card to preselect: lmstudio | ollama | gemini | openai-compat
LLM_PROVIDER=lmstudio
# Base URL of an OpenAI-compatible server (LM Studio here; Ollama = :11434/v1)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Chat + embedding model identifiers as loaded in the provider
MODEL=google/gemma-4-e4b
EMBED_MODEL=text-embedding-bge-m3

# --- Setup behaviour ---
# Where the connected config is persisted (mount this path as a volume in Docker)
LLM_CONFIG_PATH=data/llm-config.json
# Connection probe timeout in ms (raise if Ollama cold-loads a model on first call)
SETUP_PROBE_TIMEOUT_MS=10000
# Set to 0 to never auto-open a browser on startup (default in Docker)
SETUP_OPEN_BROWSER=1

# --- plant-tree MCP (run with streamable-http transport) ---
# Like the LLM vars: MCP_URL only PREFILLS the setup form / is the fallback when
# no data/mcp-config.json exists. The URL chosen at /setup is saved there and wins.
MCP_URL=http://localhost:8100/mcp
MCP_CONFIG_PATH=data/mcp-config.json

# --- Session memory (persistence) ---
# History + pendingAction được ghi ra đây để sống sót qua restart (mount volume trong Docker).
SESSIONS_PATH=data/sessions.json
# pendingAction quá hạn (ms) thì bỏ qua — mặc định 30 phút (1800000).
PENDING_TTL_MS=1800000

# Agent behaviour
MAX_TOOL_STEPS=3
RAG_TOP_K=4
DEFAULT_PLANT=strawberry

RAG_DISABLED=1
# Drop retrieved chunks below this cosine score (0 = off; tune ~0.3-0.4 via npm run eval)
RAG_MIN_SCORE=0
# Drop hits scoring more than this below the best hit (0 = off)
RAG_REL_MARGIN=0.15
# MMR relevance weight for the final top-K (1 = plain top-K)
RAG_MMR_LAMBDA=0.7
# 1 = fuse BM25 with dense ranking (reciprocal rank fusion)
RAG_HYBRID=0

# --- Scrape (npm run scrape) ---
# Crawl4AI server: docker compose --profile scrape up -d crawl4ai
# Token is required since Crawl4AI 0.9; generate one with: openssl rand -hex 32
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=change-me
# Source PDFs (downloaded once, committed) — read with opendataloader-pdf, needs Java 11+
RAG_PDF_DIR=data/pdf

# Sampling temperatures (defaults match previous hardcoded values)
LLM_DECISION_TEMP=0.1
LLM_REPLY_TEMP=0.3
